<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_card_white"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/hero_title_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We've got your"
            android:textColor="@color/ui_text_title"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/hero_title_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="back!"
            android:textColor="@color/brand_success"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginTop="-4dp" />

        <TextView
            android:id="@+id/hero_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Our smart protection is always active to keep you safe."
            android:textColor="@color/ui_text_body"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Illustration & Animation Section (High Fidelity) -->
    <FrameLayout
        android:id="@+id/hero_anim_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true">

        <!-- Background Soft Ambient Glow -->
        <View
            android:id="@+id/hero_ambient_glow"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:alpha="0.12"
            android:background="@drawable/bg_glow_dot" />

        <!-- Perspective Base / Platform -->
        <View
            android:id="@+id/hero_base_platform"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:rotationX="75"
            android:alpha="0.3"
            android:background="@drawable/bg_hero_platform" />

        <!-- Orbit Ring 1 (Tilted Perspective) -->
        <View
            android:id="@+id/hero_orbit_1"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:rotationX="72"
            android:rotationY="15"
            android:alpha="0.3"
            android:background="@drawable/bg_hero_orbit" />

        <!-- Orbit Ring 2 (Counter Tilted Perspective) -->
        <View
            android:id="@+id/hero_orbit_2"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:rotationX="60"
            android:rotationY="-20"
            android:alpha="0.25"
            android:background="@drawable/bg_hero_orbit" />

        <!-- Orbiting Icons Container (Asynchronous Motion) -->
        <FrameLayout
            android:id="@+id/orbiting_icons_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rotationX="72">
            
            <ImageView
                android:id="@+id/orbit_icon_1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:translationX="-90dp"
                android:src="@drawable/ic_orbit_person"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/orbit_icon_2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:translationY="-90dp"
                android:src="@drawable/ic_orbit_bell"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/orbit_icon_3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:translationX="90dp"
                android:src="@drawable/ic_orbit_location"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Particle Glow Dots & Plus Signs -->
        <View
            android:id="@+id/glow_dot_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:translationX="100dp"
            android:translationY="-30dp"
            android:background="@drawable/bg_glow_dot" />
        
        <ImageView
            android:id="@+id/particle_plus_1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:translationX="-90dp"
            android:translationY="-60dp"
            android:src="@drawable/ic_particle_plus"
            android:alpha="0.4" />

        <View
            android:id="@+id/glow_dot_3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:translationX="50dp"
            android:translationY="-100dp"
            android:background="@drawable/bg_glow_dot" />

        <ImageView
            android:id="@+id/particle_plus_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:translationX="80dp"
            android:translationY="70dp"
            android:src="@drawable/ic_particle_plus"
            android:alpha="0.3" />

        <!-- Main Icon Container (Stable Centering) -->
        <FrameLayout
            android:id="@+id/hero_shield_container"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center">
            
            <View
                android:id="@+id/hero_shield_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:alpha="0.05" />

            <ImageView
                android:id="@+id/hero_shield_icon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shield_checked" />
        </FrameLayout>
    </FrameLayout>

    <!-- Carousel Dots -->
    <LinearLayout
        android:id="@+id/carousel_dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal">
        <View android:id="@+id/dot_1" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_status_dot" android:layout_margin="3dp" />
        <View android:id="@+id/dot_2" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_status_dot" android:alpha="0.2" android:layout_margin="3dp" />
        <View android:id="@+id/dot_3" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_status_dot" android:alpha="0.2" android:layout_margin="3dp" />
    </LinearLayout>
</RelativeLayout>