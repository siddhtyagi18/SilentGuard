<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_main">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:padding="10dp"
                android:src="@drawable/ic_back_circular"
                app:tint="@color/ui_text_title"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#08000000"
                android:clickable="true"
                android:focusable="true" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/header_image">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Snatches"
                        android:textColor="@color/ui_text_title"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Detects sudden phone snatching"
                        android:textColor="@color/ui_text_body"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/header_image"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/feature_snatch_accent"
                    android:alpha="0.15" />
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_test_button"
        android:paddingHorizontal="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Voice Command Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feature_card_new"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:id="@+id/icon_container"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/feature_snatch_bg">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_btn_speak_now"
                            app:tint="@color/feature_snatch_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/icon_container"
                        android:layout_toStartOf="@id/switch_voice"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voice Command Trigger"
                            android:textColor="@color/ui_text_title"
                            android:fontFamily="sans-serif-bold"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trigger SOS with a custom phrase"
                            android:textColor="@color/ui_text_body"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <!-- AI Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="64dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="AI voice detection active"
                        android:textColor="@color/brand_success"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Saved Emergency Commands"
                    android:textColor="@color/ui_text_title"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-bold" />

                <LinearLayout
                    android:id="@+id/layout_custom_commands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <include layout="@layout/item_custom_command" android:id="@+id/cmd_help" />
                    <include layout="@layout/item_custom_command" android:id="@+id/cmd_pakdo" />
                    <include layout="@layout/item_custom_command" android:id="@+id/cmd_give_phone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Emergency Contacts Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feature_card_new"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ic_contacts"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/brand_success" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ic_contacts"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Emergency Contacts"
                            android:textColor="@color/ui_text_title"
                            android:fontFamily="sans-serif-bold"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Automatic alerts to trusted circle"
                            android:textColor="@color/ui_text_body"
                            android:textSize="13sp" />
                    </LinearLayout>
                </RelativeLayout>

                <Button
                    android:id="@+id/btn_import_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Import From Contacts"
                    android:textColor="@color/brand_success"
                    android:backgroundTint="#F0FDF4"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/brand_success"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Imported contacts will automatically receive SOS alerts and live location during emergencies."
                    android:textColor="@color/ui_text_body"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        <ImageView
                            android:id="@+id/ic_sms"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/brand_success" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ic_sms"
                            android:layout_marginStart="12dp"
                            android:text="SMS Alerts"
                            android:textColor="@color/ui_text_title"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_sms_alerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ic_loc"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/brand_success" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ic_loc"
                            android:layout_marginStart="12dp"
                            android:text="Live Location Sharing"
                            android:textColor="@color/ui_text_title"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_location_sharing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_contacts_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency Contacts (1)"
                        android:textColor="@color/ui_text_title"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <include layout="@layout/item_emergency_contact" android:id="@+id/contact_1" />
                    
                    <TextView
                        android:id="@+id/btn_add_contact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_gravity="center_horizontal"
                        android:text="+ Add Emergency Contact"
                        android:textColor="@color/brand_success"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_test_sos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Test Emergency Alert"
                android:textColor="@color/brand_success"
                android:backgroundTint="#F0FDF4"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp" />

            <!-- Display Off Voice Command Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feature_card_new"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ic_pwr"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_lock_power_off"
                        app:tint="@color/feature_volume_accent" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ic_pwr"
                        android:layout_toStartOf="@id/switch_display_off_voice"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Display Off Voice Command"
                            android:textColor="@color/ui_text_title"
                            android:fontFamily="sans-serif-bold"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Say &quot;display off&quot; to lock screen"
                            android:textColor="@color/ui_text_body"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_display_off_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
                <Button
                    android:id="@+id/btn_test_lock_screen"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="Test Lock Screen (Direct)"
                    android:textColor="@color/feature_volume_accent"
                    android:backgroundTint="#FFF7ED"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Screen Off Mode Card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feature_card_new"
                android:padding="20dp">
                <ImageView
                    android:id="@+id/ic_eye"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/feature_snatch_accent" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/ic_eye"
                    android:layout_toStartOf="@id/switch_screen"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screen Off Mode"
                        android:textColor="@color/ui_text_title"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App works even when screen is off"
                        android:textColor="@color/ui_text_body"
                        android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/bottom_test_button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:text="Test Phone Snatch"
        android:textColor="@color/ui_card_white"
        android:backgroundTint="@color/feature_snatch_accent"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-black"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
