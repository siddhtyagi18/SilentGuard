<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <!-- Emergency Container with Beautiful Gradient -->
    <LinearLayout
        android:id="@+id/popup_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_emergency_popup"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:elevation="24dp">

        <!-- Emergency Icon with Animated Pulse Rings -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="28dp">

            <!-- Outer Pulse Ring -->
            <View
                android:id="@+id/pulse_ring_outer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_emergency_pulse_ring"
                android:alpha="0.3" />

            <!-- Inner Pulse Ring -->
            <View
                android:id="@+id/pulse_ring_inner"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_emergency_pulse_ring"
                android:alpha="0.5" />

            <!-- Icon Glow Background -->
            <View
                android:id="@+id/icon_glow"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_emergency_icon_glow"
                android:alpha="0.6" />

            <!-- Emergency Call Icon -->
            <ImageView
                android:id="@+id/iv_warning"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_call"
                app:tint="@color/emergency_text_primary" />
        </FrameLayout>

        <!-- Emergency Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY ALERT!"
            android:textColor="@color/emergency_red"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do you want to call your\nsaved emergency contact?"
            android:textColor="@color/emergency_text_primary"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Countdown Timer -->
        <TextView
            android:id="@+id/tv_sub_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calling in 10 seconds..."
            android:textColor="@color/emergency_red_light"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:fontFamily="sans-serif-bold"
            android:visibility="visible" />

        <!-- Buttons with Beautiful Gradients -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Cancel Button -->
            <Button
                android:id="@+id/btn_negative"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textColor="@color/emergency_text_primary"
                android:background="@drawable/bg_emergency_button_cancel"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-bold"
                android:textSize="15sp"
                android:layout_marginEnd="12dp" />

            <!-- Call Now Button (Red Gradient) -->
            <Button
                android:id="@+id/btn_positive"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="CALL NOW"
                android:textColor="@color/emergency_text_primary"
                android:background="@drawable/bg_emergency_button_call"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-black"
                android:textSize="16sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Emergency Red Pulse Overlay -->
    <View
        android:id="@+id/siren_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#30E94560"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>