<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_primary">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add/Edit Contact"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/et_contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/neon_violet"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_contact_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/neon_violet"
        android:padding="12dp"
        android:inputType="phone"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_contact_relation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Relation (e.g., Guardian, Family)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/neon_violet"
        android:padding="12dp"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_cancel_contact"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Cancel"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/ui_text_body"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            style="@style/Widget.Material3.Button.TextButton"/>

        <Button
            android:id="@+id/btn_save_contact"
            android:layout_width="120dp"
            android:layout_height="52dp"
            android:text="Save"
            android:textColor="@color/ui_card_white"
            android:backgroundTint="@color/ui_text_title"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-bold"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</LinearLayout>
